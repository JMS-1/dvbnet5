{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "processName": "JMS.VCR.NET",
      "request": "attach",
      "type": "coreclr"
    },
    {
      "name": "Card-Server",
      "request": "attach",
      "type": "coreclr",
      "processId": "${input:FindCardServer}"
    },
    {
      "args": [],
      "cwd": "${workspaceFolder}/WebServer",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "name": "Startup",
      "preLaunchTask": "build-server",
      "program": "${workspaceFolder}/WebServer/bin/Debug/net9.0/JMS.VCR.NET.dll",
      "request": "launch",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "stopAtEntry": false,
      "type": "coreclr"
    }
  ],
  "inputs": [
    {
      "id": "FindCardServer",
      "type": "command",
      "command": "shellCommand.execute",
      "args": {
        "command": "ps -eo pid,comm,args | grep dotnet | grep JMS.DVB.NET.CardServer.dll | grep -v grep | awk '{print $1}'",
        "useFirstResult": true
      }
    }
  ]
}
